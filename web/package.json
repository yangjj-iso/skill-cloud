{
  "name": "skill-cloud-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web UI for Skill Cloud (Vite + React).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
